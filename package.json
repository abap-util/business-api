{
  "name": "business-api",
  "private": true,
  "description": "Class-based access to the SAP logistics BAPIs",
  "license": "MIT",
  "scripts": {
    "lint": "abaplint ./abaplint.jsonc",
    "downport": "abaplint --fix .github/abaplint/abap_702.jsonc; abaplint .github/abaplint/abap_702.jsonc",
    "rename": "abaplint .github/abaplint/rename.jsonc --rename",
    "contract": "node .github/scripts/check-contract.mjs",
    "transpile": "rm -rf node/output && abap_transpile ./node/setup/abap_transpile.json",
    "unit": "node node/output/index.mjs",
    "check": "npm run lint && npm run rename && npm run contract",
    "test": "npm run check && npm run transpile && npm run unit"
  },
  "devDependencies": {
    "@abaplint/cli": "2.120.120",
    "@abaplint/runtime": "2.14.15",
    "@abaplint/transpiler-cli": "2.14.15"
  }
}
